# PIEmgmaker 인증 프록시 — $PORT에서 Bearer 토큰을 검증하고 127.0.0.1:8188의 ComfyUI로 넘긴다.
#
# 이 템플릿은 entrypoint.sh가 envsubst로 렌더링한다. 치환 대상은 다음 5개뿐이고
# (envsubst에 SHELL-FORMAT을 명시), $http_authorization 같은 nginx 변수는 그대로 남는다.
#   ${PM_PORT} ${PM_RUNTIME_DIR} ${PM_ACCESS_LOG} ${PM_STATUS_PORT} ${PM_PROXY_TOKEN}
#
# 토큰을 설정 파일에 넣는 이유: nginx 코어는 요청 시점에 환경변수를 읽지 못한다.
# 그렇게 하려면 njs/perl 모듈이 필요한데 이는 새 의존성이다. 대신 렌더 결과를
# mktemp -d(0700) 안의 0600 파일로만 두고 컨테이너 종료 시 지운다. 값은 어디에도 로깅하지 않는다.

worker_processes 1;
daemon off;
user www-data;
pid ${PM_RUNTIME_DIR}/nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 512;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    sendfile on;

    client_body_temp_path ${PM_RUNTIME_DIR}/body;
    proxy_temp_path ${PM_RUNTIME_DIR}/proxy;
    fastcgi_temp_path ${PM_RUNTIME_DIR}/fastcgi;
    uwsgi_temp_path ${PM_RUNTIME_DIR}/uwsgi;
    scgi_temp_path ${PM_RUNTIME_DIR}/scgi;

    # 참조 이미지 업로드와 결과 PNG 회수가 대용량이다. 양방향 모두 버퍼링 없이 흘려보낸다.
    client_max_body_size 512m;
    client_body_buffer_size 1m;
    proxy_http_version 1.1;
    proxy_buffering off;
    proxy_request_buffering off;

    # 생성 1건이 분 단위(콜드 스타트 포함 최대 16분 추정)라 Cloud Run 요청 타임아웃 3600초에 맞춘다.
    client_body_timeout 300s;
    keepalive_timeout 620s;
    proxy_connect_timeout 30s;
    proxy_send_timeout 3600s;
    proxy_read_timeout 3600s;
    send_timeout 3600s;

    # Authorization 헤더는 어떤 로그 포맷에도 넣지 않는다 (토큰 로깅 금지).
    log_format pm_min '$time_iso8601 $status $request_method $uri $body_bytes_sent $request_time';

    # 아래 map의 키가 "Bearer <토큰>"이라 기본 버킷(64바이트)을 넘는다 — 허용 토큰
    # 최대 길이(512자)까지 수용하도록 키운다. 없으면 could not build map_hash로 기동 실패.
    map_hash_bucket_size 1024;

    map $http_authorization $pm_auth_ok {
        default                     0;
        "Bearer ${PM_PROXY_TOKEN}"  1;
    }

    # 인증을 통과한 요청만 와치독용 액세스 로그에 남긴다.
    # 401 트래픽이 액세스 로그 mtime을 갱신해 자기 종료를 지연시키면 그대로 GPU 과금이 된다.
    map $pm_auth_ok $pm_loggable {
        1       1;
        default 0;
    }

    upstream comfyui {
        server 127.0.0.1:8188;
        keepalive 8;
    }

    server {
        listen ${PM_PORT} default_server;
        server_name _;

        access_log ${PM_ACCESS_LOG} pm_min if=$pm_loggable;

        # Cloud Run 시작 프로브용. 인증 없이 준비 상태만 알리고 본문에 정보를 담지 않는다.
        # access_log off — 프로브가 유휴 와치독의 "마지막 요청 시각"을 갱신하면 안 된다.
        location = /pm-healthz {
            access_log off;
            default_type text/plain;
            if (-f ${PM_RUNTIME_DIR}/comfy_ready) {
                return 200 "ok\n";
            }
            return 503 "starting\n";
        }

        # ComfyUI 진행률 웹소켓. 원격 엔진은 HTTP 폴링만 쓰지만 계약상 열어둔다.
        # keepalive upstream은 Connection 헤더를 비우므로 여기서는 직접 주소로 보낸다.
        location /ws {
            if ($pm_auth_ok = 0) {
                return 401 "unauthorized\n";
            }
            proxy_pass http://127.0.0.1:8188;
            proxy_set_header Authorization "";
            proxy_set_header Host $host;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location / {
            if ($pm_auth_ok = 0) {
                return 401 "unauthorized\n";
            }
            proxy_pass http://comfyui;
            # 토큰이 ComfyUI 쪽 로그로 새지 않도록 업스트림에는 넘기지 않는다.
            proxy_set_header Authorization "";
            proxy_set_header Host $host;
            proxy_set_header Connection "";
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }

    # 와치독 전용 — 처리 중인 요청이 있는지 판정한다.
    # 큐가 비어 있어도 업로드/다운로드가 진행 중일 수 있어 액세스 로그만으로는 부족하다.
    # (요청은 완료 시점에 기록되므로 콜드 스타트 중 첫 요청이 로그에 없다.)
    server {
        listen 127.0.0.1:${PM_STATUS_PORT};
        server_name _;
        access_log off;

        location = /pm-nginx-status {
            stub_status;
            allow 127.0.0.1;
            deny all;
        }

        location / {
            return 404 "not found\n";
        }
    }
}
