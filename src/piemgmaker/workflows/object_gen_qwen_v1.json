{
  "__meta__": {
    "image_out": "8",
    "save_node": "9",
    "note": "object-gen-qwen-v1 — Qwen-Image GGUF 경로. ComfyUI 공식 Qwen 워크플로우 구성: UnetLoaderGGUF + CLIPLoader(qwen_image) + ModelSamplingAuraFlow(shift 3.1) + EmptySD3LatentImage."
  },
  "1": { "class_type": "UnetLoaderGGUF", "inputs": { "unet_name": "__MODEL__" } },
  "2": { "class_type": "CLIPLoader", "inputs": { "clip_name": "__CLIP__", "type": "qwen_image", "device": "default" } },
  "3": { "class_type": "VAELoader", "inputs": { "vae_name": "__VAE__" } },
  "4": { "class_type": "ModelSamplingAuraFlow", "inputs": { "model": ["1", 0], "shift": 3.1 } },
  "5": { "class_type": "CLIPTextEncode", "inputs": { "text": "__POSITIVE__", "clip": ["2", 0] } },
  "6": { "class_type": "CLIPTextEncode", "inputs": { "text": "__NEGATIVE__", "clip": ["2", 0] } },
  "7": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["4", 0],
      "positive": ["5", 0],
      "negative": ["6", 0],
      "latent_image": ["10", 0],
      "seed": 0,
      "steps": "__STEPS__",
      "cfg": "__CFG__",
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0
    }
  },
  "8": { "class_type": "VAEDecode", "inputs": { "samples": ["7", 0], "vae": ["3", 0] } },
  "9": { "class_type": "SaveImage", "inputs": { "images": ["8", 0], "filename_prefix": "__PREFIX__" } },
  "10": { "class_type": "EmptySD3LatentImage", "inputs": { "width": "__WIDTH__", "height": "__HEIGHT__", "batch_size": 1 } }
}
