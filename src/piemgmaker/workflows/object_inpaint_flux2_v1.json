{
  "__meta__": {
    "image_out": "16",
    "save_node": "17",
    "note": "object-inpaint-flux2-v1 — 선배치 캔버스 + 2단 마스크. FLUX.2는 커스텀 샘플링 경로라 부분 denoise 대신 마스크 노이즈 주입(SetLatentNoiseMask)만 사용(v1). 코어 보존은 paste-back이 종단 보장."
  },
  "1": { "class_type": "UnetLoaderGGUF", "inputs": { "unet_name": "__MODEL__" } },
  "2": { "class_type": "CLIPLoader", "inputs": { "clip_name": "__CLIP__", "type": "flux2", "device": "default" } },
  "3": { "class_type": "VAELoader", "inputs": { "vae_name": "__VAE__" } },
  "4": { "class_type": "CLIPTextEncode", "inputs": { "text": "__POSITIVE__", "clip": ["2", 0] } },
  "5": { "class_type": "FluxGuidance", "inputs": { "conditioning": ["4", 0], "guidance": "__CFG__" } },
  "6": { "class_type": "BasicGuider", "inputs": { "model": ["1", 0], "conditioning": ["5", 0] } },
  "7": { "class_type": "KSamplerSelect", "inputs": { "sampler_name": "euler" } },
  "8": { "class_type": "Flux2Scheduler", "inputs": { "steps": "__STEPS__", "width": "__WIDTH__", "height": "__HEIGHT__" } },
  "9": { "class_type": "RandomNoise", "inputs": { "noise_seed": 0 } },
  "10": { "class_type": "LoadImage", "inputs": { "image": "__CANVAS__" } },
  "11": { "class_type": "LoadImage", "inputs": { "image": "__MASK_IMAGE__" } },
  "12": { "class_type": "ImageToMask", "inputs": { "image": ["11", 0], "channel": "red" } },
  "13": { "class_type": "VAEEncode", "inputs": { "pixels": ["10", 0], "vae": ["3", 0] } },
  "14": { "class_type": "SetLatentNoiseMask", "inputs": { "samples": ["13", 0], "mask": ["12", 0] } },
  "15": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": { "noise": ["9", 0], "guider": ["6", 0], "sampler": ["7", 0], "sigmas": ["8", 0], "latent_image": ["14", 0] }
  },
  "16": { "class_type": "VAEDecode", "inputs": { "samples": ["15", 0], "vae": ["3", 0] } },
  "17": { "class_type": "SaveImage", "inputs": { "images": ["16", 0], "filename_prefix": "__PREFIX__" } }
}
