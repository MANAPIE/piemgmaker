{
  "__meta__": {
    "image_out": "7",
    "save_node": "8",
    "note": "object-gen-v1 — 자산 없음 경로. 베이스 모델은 __MODEL__ 슬롯. opaque는 단색 배경 강제 프롬프트 + 매팅 조각 합성으로 알파 산출."
  },
  "1": { "class_type": "CheckpointLoaderSimple", "inputs": { "ckpt_name": "__MODEL__" } },
  "2": { "class_type": "CLIPTextEncode", "inputs": { "text": "__POSITIVE__", "clip": ["1", 1] } },
  "3": { "class_type": "CLIPTextEncode", "inputs": { "text": "__NEGATIVE__", "clip": ["1", 1] } },
  "4": { "class_type": "EmptyLatentImage", "inputs": { "width": "__WIDTH__", "height": "__HEIGHT__", "batch_size": 1 } },
  "5": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["1", 0],
      "positive": ["2", 0],
      "negative": ["3", 0],
      "latent_image": ["4", 0],
      "seed": 0,
      "steps": "__STEPS__",
      "cfg": "__CFG__",
      "sampler_name": "euler",
      "scheduler": "normal",
      "denoise": 1.0
    }
  },
  "7": { "class_type": "VAEDecode", "inputs": { "samples": ["5", 0], "vae": ["1", 2] } },
  "8": { "class_type": "SaveImage", "inputs": { "images": ["7", 0], "filename_prefix": "__PREFIX__" } }
}
